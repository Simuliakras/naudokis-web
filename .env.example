# Naudokis web — environment variables. Copy to .env.local for local dev.
# Everything here is optional; the build runs against prod defaults if unset.

# Backend REST API base URL. Defaults to production so a misconfigured build
# never silently hits dev. Point at dev locally: https://api-dev.naudokis.lt
# NEXT_PUBLIC_API_BASE_URL=https://api.naudokis.lt

# Google Maps Static API key for the listing-detail map. No key -> the map falls
# back to the decorative delivery-zone backdrop (fine for local dev/screenshots).
#
# SERVER-ONLY, and deliberately not NEXT_PUBLIC_: the browser never talks to Google.
# app/api/map builds and fetches the styled map itself, so the key stays out of the
# HTML — the old NEXT_PUBLIC_ form was inlined into every listing page.
#
# It is read at REQUEST time, which on Amplify means it must also be listed in the
# .env.production block in amplify.yml — Amplify does not pass environment variables
# into the SSR runtime, so an app-level variable alone leaves it empty and the route
# 404s on every listing. Rotating it is therefore a rebuild, not an env-var edit.
#
# Restrict the key to the Maps Static API, and do NOT give it an HTTP-referrer
# restriction: the request is server-to-server and carries no Referer.
# GOOGLE_MAPS_API_KEY=

# Sentry error monitoring. No DSN -> Sentry no-ops (fine for local dev).
# NEXT_PUBLIC_SENTRY_DSN=
# Used by the build to upload source maps; CI/deploy only, never commit a real one.
# SENTRY_AUTH_TOKEN=

# Google Analytics 4 (gtag.js) with Consent Mode v2, default-denied: no analytics
# cookies before the visitor accepts the site-wide consent banner. No id -> no GA
# script, no banner, no cookies (fine for local dev).
# SPA pageviews rely on the GA property's enhanced-measurement option "Page
# changes based on browser history events" (ON by default) — keep it enabled.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Chrome UX Report API key used only by `yarn verify:field-cwv`. The command checks
# the rolling 28-day PHONE p75 LCP and fails unless it is <= 2.5 seconds. This is a
# release-evidence check, not a runtime variable; do not put it in Amplify's shipped
# .env.production file.
# CRUX_API_KEY=
# Optional: point that check at a different origin (defaults to the production site).
# CWV_ORIGIN=https://www.naudokis.lt

# Search-engine ownership proof, rendered as a <meta> tag by the root layout.
# Unset -> no tag is emitted. Use these when verifying the property without DNS
# access; the value is the bare token, not the whole tag.
# Read during generateMetadata on statically-generated pages, so these are baked
# at BUILD time: setting them in the runtime environment after deploy does
# nothing, and changing one requires a rebuild.
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=

# iOS Team ID + bundle identifier. This value is public and must match the AASA.
APPLE_APP_ID=U2NZQ56A8W.com.naudokislt.naudokis

# Android App Links. Required before launch: SHA-256 certificate fingerprints,
# comma/newline/semicolon separated. Include every certificate that signs an
# INSTALLABLE release — the Play app-signing certificate, plus any active
# signing-key rotation certificate. Do NOT add the upload certificate: it does not
# sign Play-distributed APKs, and publishing it only widens what can claim these
# links. See public/.well-known/README.md.
# ANDROID_APP_LINK_SHA256_CERT_FINGERPRINTS=AB:CD:...
ANDROID_APP_LINK_PACKAGE_NAME=com.naudokis.naudokis

# Number of reverse proxies WE control in front of the app (1 for a single CDN or
# load balancer). This is how the API rate limiter finds the real client address:
# X-Forwarded-For is appended to by each hop, so only the right-most entries are
# trustworthy. Unset/0 means the header is not trusted at all and per-client rate
# limiting is disabled (routes fall back to a global backstop) — set this to the
# real hop count once the hosting platform is chosen.
# TRUSTED_PROXY_HOPS=1

# AppsFlyer OneLink template base for the /invite referral links and the /go smart
# install link. No value -> install links degrade to the /go OS-sniff redirect.
# Live branded-domain template: https://link.naudokis.lt/LNBm (custom OneLink
# subdomain; AppsFlyer hosts its SSL + .well-known association files). Set the real
# value in the prod build env — NEXT_PUBLIC_* is inlined at build time, so a rebuild
# is required. Left commented so local/dev builds stay on the /go fallback by default.
# MUST be the branded link.naudokis.lt host: it is the only one registered on the
# app side, so a naudokis.onelink.me template resolves but never opens the app
# (app team, 2026-07-21).
#
# The TRAILING PATH SEGMENT IS LOAD-BEARING — do not "tidy" it away. AppsFlyer's
# own association file at link.naudokis.lt claims paths ["/LNBm/*"], and Apple
# compares the path only (query ignored), so the bare "/LNBm" matches NOTHING:
# iOS opens Safari, follows AppsFlyer's 301 and lands on the App Store even when
# the app is already installed. Any segment satisfies the claim; "i" (install) is
# arbitrary and AppsFlyer treats an unregistered suffix as the plain template —
# verified identical on iOS/Android/desktop, install referrer intact.
# `yarn verify:app-links` now fetches that file and enforces the match.
# NEXT_PUBLIC_ONELINK_URL=https://link.naudokis.lt/LNBm/i
# Server-only HMAC key (32+ random characters). /go puts a signed journey token
# into OneLink deep_link_sub10 so the app can recognize a web handoff. The web
# endpoint that ingested outcome events (/api/handoff-event) was removed with the
# Plausible→GA migration; the token itself still travels unchanged.
# HANDOFF_SIGNING_SECRET=
